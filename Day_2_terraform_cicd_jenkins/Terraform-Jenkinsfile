pipeline{
    agent any
        stages{

            stage('git checkout'){
                steps {
                    git branch: 'main', url: 'https://github.com/Yamini-Eshwar/CICD-series.git'
                }
            }

            stage('init'){
                steps{
                    dir('Day_2_terraform_cicd_jenkins') {
                        sh 'terraform init'

                    }                   
                }
            }

            stage('plan'){
                steps{
                    dir('Day_2_terraform_cicd_jenkins') {
                        sh 'terraform plan'
                    }
                }
            }

            stage('apply'){
                steps{
                    dir('Day_2_terraform_cicd_jenkins') {
                        sh 'terraform apply -auto-approve'
                    }
                }
            }

            stage

        }
    
}